---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('writing');
  return articles.map(a => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(article);
const { readingTime } = remarkPluginFrontmatter;
---

<BaseLayout
  title={`${article.data.title} — Keogan Larade`}
  description={article.data.summary ?? `${article.data.title} — writing by Keogan Larade.`}
>
  <p class="back" transition:name="back-link"><a href="/writing">← writing</a></p>
  <h1 class="name" transition:name="page-heading">{article.data.title}</h1>
  <p class="article-meta">
    <span class="article-year">{article.data.year}</span>
    <span>·</span>
    <span class="article-readtime">{readingTime}</span>
    {article.data.tags.length > 0 && <span>·</span>}
    {article.data.tags.map(tag => <span class="article-tag">{tag}</span>)}
  </p>
  <div class="article-body">
    <Content />
  </div>
  <p class="back back-bottom" hidden><a href="/writing">← writing</a></p>
</BaseLayout>

<style>
  .back-bottom { position: static; margin-top: 4rem; }
  .name { margin-bottom: 1.25rem; }
  .article-meta { margin-bottom: 4rem; }
</style>

<script>
  function checkBottomBack() {
    const el = document.querySelector('.back-bottom');
    if (!el) return;
    if (document.documentElement.scrollHeight > window.innerHeight) {
      el.removeAttribute('hidden');
    } else {
      el.setAttribute('hidden', '');
    }
  }
  checkBottomBack();
  document.addEventListener('astro:page-load', checkBottomBack);
</script>
