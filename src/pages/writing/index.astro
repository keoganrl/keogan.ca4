---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = [...new Set(articles.flatMap(a => a.data.tags))].sort();
---

<BaseLayout title="Writing — Keogan Larade">
  <p class="back"><a href="/">← back</a></p>
  <h1 class="name">Writing</h1>

  <nav class="tags">
    <button class="tag active" data-filter="all">all</button>
    {allTags.map(tag => (
      <button class="tag" data-filter={tag}>{tag}</button>
    ))}
  </nav>

  <ul class="article-list">
    {articles.map(a => (
      <li class="article-item" data-tags={a.data.tags.join(',')}>
        <a href={`/writing/${a.id}`}>
          <span class="article-year">{a.data.year}</span>
          <span class="article-title">{a.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .back { position: absolute; top: 4rem; left: 1.75rem; margin: 0; }
  .name { margin-bottom: 1.25rem; }
</style>

<script>
  function initFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag');
    const items = document.querySelectorAll<HTMLLIElement>('.article-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.dataset.filter!;
        items.forEach(item => {
          const tags = item.dataset.tags!.split(',');
          item.style.display = (filter === 'all' || tags.includes(filter)) ? '' : 'none';
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initFilter);
</script>
