---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Keogan Larade`}>
  <p class="back"><a href="/projects">← projects</a></p>
  <h1 class="name">{project.data.title}</h1>
  <p class="article-meta">
    <span class="article-year">{project.data.year}</span>
    {project.data.tags.map(tag => <span class="article-tag">{tag}</span>)}
  </p>
  <div class="article-body">
    <Content />
  </div>
  {project.data.link && (
    <p class="project-link"><a href={project.data.link} target="_blank" rel="noopener">View project →</a></p>
  )}
  <p class="back back-bottom" hidden><a href="/projects">← projects</a></p>
</BaseLayout>

<style>
  .back-bottom { position: static; margin-top: 4rem; }
  .name { margin-bottom: 1.25rem; }
  .article-meta { margin-bottom: 4rem; }
</style>

<script>
  function checkBottomBack() {
    const el = document.querySelector('.back-bottom');
    if (!el) return;
    if (document.documentElement.scrollHeight > window.innerHeight) {
      el.removeAttribute('hidden');
    } else {
      el.setAttribute('hidden', '');
    }
  }
  checkBottomBack();
  document.addEventListener('astro:page-load', checkBottomBack);
</script>
