---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  description="Keogan Larade — writing, projects, and notes on quantum computing, music, and art."
  bodyClass="is-home"
>
  <div class="home-desktop">
    <aside class="home-rail">
      <ul class="home-directory">
        <li>
          <a href="/writing">
            <span class="slash">/</span>
            <span class="label">writing</span>
          </a>
        </li>
        <li>
          <a href="/projects">
            <span class="slash">/</span>
            <span class="label">projects</span>
          </a>
        </li>
        <li>
          <a href="/guestbook">
            <span class="slash">/</span>
            <span class="label">guestbook</span>
          </a>
        </li>
      </ul>
      <div class="home-social">
        <a href="https://www.linkedin.com/in/keoganlarade/" target="_blank" rel="noopener">
          <img src="/images/linkedin.png" alt="LinkedIn" />
        </a>
        <a href="mailto:keog@nlara.de">
          <img src="/images/mail.png" alt="Email" />
        </a>
      </div>
    </aside>
    <div class="home-divider"></div>
    <main class="home-main">
      <div class="home-content">
        <h1 class="name home-name" transition:name="page-heading">Keogan Larade</h1>
        <p class="blurb">
          Nanotech engineering at Waterloo, superconducting circuit design at D-Wave. Hobby pianist and graphite artist.
        </p>
        <div class="images home-images">
          <div class="left"><img src="/images/canoe.jpg" alt="Canoe on still water" /></div>
          <div class="right"><img src="/images/portrait.jpg" alt="Portrait of Keogan Larade" /></div>
        </div>
      </div>
    </main>
  </div>

  <div class="home-mobile">
    <div class="home-fold">
      <h1 class="name">Keogan Larade</h1>
      <p class="blurb">
        Nanotech engineering at Waterloo, superconducting circuit design at D-Wave. Hobby pianist and graphite artist.
      </p>
      <div class="images">
        <div class="left"><img src="/images/canoe.jpg" alt="Canoe on still water" /></div>
        <div class="right"><img src="/images/portrait.jpg" alt="Portrait of Keogan Larade" /></div>
      </div>
      <section class="directory">
        <h2>Directory</h2>
        <ul>
          <li><a href="/writing"><img class="link-logo" src="/images/slash.png" alt="" />writing</a></li>
          <li><a href="/projects"><img class="link-logo" src="/images/slash.png" alt="" />projects</a></li>
          <li><a href="/guestbook"><img class="link-logo" src="/images/slash.png" alt="" />guestbook</a></li>
        </ul>
      </section>
    </div>
    <footer class="footer">
      <a href="https://www.linkedin.com/in/keoganlarade/" target="_blank" rel="noopener">
        <img class="footer-logo" src="/images/linkedin.png" alt="LinkedIn" />
      </a>
      <a href="mailto:keog@nlara.de">
        <img class="footer-logo" src="/images/mail.png" alt="Email" />
      </a>
    </footer>
  </div>
</BaseLayout>

<style>
  .home-desktop { display: none; }

  /* ---- Mobile / tablet: fit items 1–5 to the viewport ----------------------
     The fold (name → blurb → images → directory) is one flex column as tall as
     the small viewport, minus a small inset so the directory's last line sits
     just above the bottom edge rather than flush against it.

     The gaps used to be fixed margins of 7 / 4.5 / 5 / 5 rem (body padding-top,
     then name, blurb, images). Here they become flex-grow factors in those same
     ratios, so whatever space is left over after the text and images are laid
     out gets shared between them in the original proportions — on any phone
     height, and whether the blurb wraps to three lines or five.

     Growth is applied to the elements themselves rather than to spacer divs:
     .name and .blurb are block boxes whose text stays top-aligned, so their
     extra height reads as the gap below them. .images must NOT grow (its
     children are height: 100%, so a taller box would stretch the photos), so
     the gap above the directory comes from growing .directory instead and
     bottom-aligning its contents. */
  @media (max-width: 1099px) {
    .home-fold {
      display: flex;
      flex-direction: column;
      min-height: calc(100vh - 2.5rem);
      min-height: calc(100svh - clamp(1.75rem, 4svh, 3rem));
    }

    /* The old 7rem body padding-top, now elastic. min-height keeps a floor if
       the content ever outgrows the viewport (large text sizes). */
    .home-fold::before {
      content: '';
      flex: 7 0 0;
      min-height: 2rem;
    }

    .home-fold > .name { flex: 4.5 0 auto; margin: 0; }
    .home-fold > .blurb { flex: 5 0 auto; margin: 0; }
    .home-fold > .images { flex: 0 0 auto; margin: 0; }

    .home-fold > .directory {
      flex: 5 0 auto;
      margin: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    /* Below the fold. Kept in proportion with the gaps above it (it was the
       largest of them at 8rem) so the scroll down to the icons feels the same. */
    .home-mobile > .footer { margin-top: clamp(6rem, 21svh, 13rem); }
  }

  @media (min-width: 1100px) {
    .home-mobile { display: none; }

    .home-desktop {
      position: relative;
      display: flex;
      min-height: 100vh;
    }

    .home-rail {
      flex-shrink: 0;
      position: sticky;
      top: 0;
      height: 100vh;
      box-sizing: border-box;
      padding: 0 clamp(1.5rem, 4vw, 4rem) 0 0;
      display: flex;
      flex-direction: column;
      width: calc(38.667vw - 227.33px);
    }

    .home-directory {
      list-style: none;
      padding: 0;
      margin: 0;
      align-self: flex-end;
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 1.4vh, 2rem);
      align-items: flex-start;
    }

    .home-directory li {
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.6;
    }

    .home-directory a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      color: #3a3a3a;
      text-decoration: none;
    }

    .home-directory .slash {
      font-family: 'Libre Baskerville', Georgia, serif;
      font-style: italic;
      opacity: 0.75;
    }

    .home-directory .label {
      transition: transform 1s ease, color 0.15s ease;
    }

    .home-social {
      margin-top: auto;
      align-self: flex-end;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .home-social a {
      border-bottom: 1px solid transparent;
      display: inline-flex;
    }

    .home-social img {
      width: 1.8em;
      height: 1.8em;
      object-fit: contain;
      opacity: 0.75;
      display: block;
      transition: transform 1s ease;
    }

    .home-divider {
      position: absolute;
      width: 2px;
      background: #eee;
      border-radius: 2px;
      pointer-events: none;
      top: 0;
      left: 0;
      height: 100vh;
    }

    .home-main {
      flex: 1;
      min-width: 0;
      padding: 6vh clamp(1.5rem, 4vw, 4rem);
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }

    .home-content {
      max-width: min(820px, 600px + 15vw);
      width: 100%;
      transform: translateY(-1.5vh);
    }

    .home-name {
      margin: 0 0 clamp(2.5rem, 9vh, 12rem);
    }

    .home-desktop .blurb {
      margin: 0 0 clamp(3rem, 11vh, 14rem);
    }

    .home-images {
      margin: 0;
    }
  }

  @media (min-width: 1550px) {
    .home-rail { width: 24vw; }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-directory a:hover .label {
      transform: translateX(5px);
      color: #2a2a2a;
      transition: transform 0.27s ease, color 0.15s ease;
    }
    .home-social a:hover img {
      transform: scale(1.2);
      transition: transform 0.27s ease;
    }
  }
</style>

<script>
  function measureHomeSplit() {
    const rail = document.querySelector<HTMLElement>('.home-rail');
    const divider = document.querySelector<HTMLElement>('.home-divider');
    const name = document.querySelector<HTMLElement>('.home-name');
    const images = document.querySelector<HTMLElement>('.home-images');
    if (!rail || !divider || !name || !images) return;
    if (!window.matchMedia('(min-width: 1100px)').matches) return;

    const INSET_TOP = 14;
    const nameTop = name.getBoundingClientRect().top;
    const imagesBottom = images.getBoundingClientRect().bottom;
    const PAD = 22 + Math.max(0, window.innerHeight - 700) * 0.1;

    rail.style.paddingTop = Math.max(0, nameTop + INSET_TOP) + 'px';
    rail.style.paddingBottom = Math.max(0, window.innerHeight - imagesBottom) + 'px';

    const top = nameTop - PAD;
    const bottom = imagesBottom + PAD;
    divider.style.top = top + 'px';
    divider.style.height = Math.max(0, bottom - top) + 'px';
    divider.style.left = rail.getBoundingClientRect().right + 'px';
  }

  function scheduleMeasure() {
    requestAnimationFrame(measureHomeSplit);
  }

  scheduleMeasure();
  document.addEventListener('astro:page-load', scheduleMeasure);
  document.addEventListener('astro:after-swap', scheduleMeasure);

  if (!(window as any).__homeMeasureBound) {
    window.addEventListener('resize', scheduleMeasure);
    window.addEventListener('load', scheduleMeasure);
    (window as any).__homeMeasureBound = true;
  }
</script>
