---
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import canoe from '../assets/images/canoe.jpg';
import portrait from '../assets/images/portrait.jpg';
import drawing from '../assets/images/GenesisCoupeDrawing.jpeg';
import linkedin from '../assets/images/linkedin.png';
import mail from '../assets/images/mail.png';

// The edition mark at the foot of the page. Hardcoded: it dates this version of
// the site, so it changes when the site does, not when the calendar does.
const YEAR = '2026';

// One set of image props for both layouts, so the desktop and mobile copies
// share a single srcset (and so a single download).
const canoeProps = {
  src: canoe,
  alt: 'Canoe on still water',
  formats: ['avif', 'webp'],
  widths: [560, 1080, 1600],
  sizes: '(min-width: 1100px) min(560px, 40vw), 66vw',
  loading: 'eager',
} as const;
const drawingProps = {
  src: drawing,
  alt: 'Graphite drawing of a Genesis Coupe',
  formats: ['avif', 'webp'],
  widths: [560, 1080],
  sizes: '(min-width: 1100px) min(560px, 40vw), 66vw',
  loading: 'lazy',
} as const;
const portraitProps = {
  src: portrait,
  alt: 'Portrait of Keogan Larade',
  formats: ['avif', 'webp'],
  widths: [300, 600],
  sizes: '(min-width: 1100px) 280px, 33vw',
  loading: 'eager',
} as const;
---

<BaseLayout
  description="Keogan Larade — writing, projects, and notes on quantum computing, music, and art."
  bodyClass="is-home"
>
  <div class="home-desktop">
    <aside class="home-rail">
      <ul class="home-directory">
        <li>
          <a href="/writing">
            <span class="slash">/</span>
            <span class="label">writing</span>
          </a>
        </li>
        <li>
          <a href="/projects">
            <span class="slash">/</span>
            <span class="label">projects</span>
          </a>
        </li>
        <li>
          <a href="/guestbook">
            <span class="slash">/</span>
            <span class="label">guestbook</span>
          </a>
        </li>
      </ul>
      <div class="home-social">
        <a href="https://www.linkedin.com/in/keoganlarade/" target="_blank" rel="noopener">
          <Image src={linkedin} width={72} sizes="32px" alt="LinkedIn" />
        </a>
        <a href="mailto:keog@nlara.de">
          <Image src={mail} width={72} sizes="32px" alt="Email" />
        </a>
      </div>
    </aside>
    <main class="home-main">
      <div class="home-content">
        <h1 class="name home-name">Keogan Larade</h1>
        <p class="blurb">
          Nanotech engineering at Waterloo, superconducting circuit design at D-Wave. Hobby pianist and graphite artist.
        </p>
        <div class="images home-images">
          <button class="left flip" type="button" aria-pressed="false" aria-label="Swap the canoe photo for one of my graphite drawings">
            <Picture {...canoeProps} alt="" />
            <Picture {...drawingProps} alt="" class="flip-drawing" />
          </button>
          <div class="right"><Picture {...portraitProps} /></div>
        </div>
      </div>
    </main>
    <p class="site-year home-year" aria-hidden="true">{YEAR}</p>
  </div>

  <div class="home-mobile">
    <div class="home-fold">
      <h1 class="name">Keogan Larade</h1>
      <p class="blurb">
        Nanotech engineering at Waterloo, superconducting circuit design at D-Wave. Hobby pianist and graphite artist.
      </p>
      <div class="images">
        <button class="left flip" type="button" aria-pressed="false" aria-label="Swap the canoe photo for one of my graphite drawings">
          <Picture {...canoeProps} alt="" />
          <Picture {...drawingProps} alt="" class="flip-drawing" />
        </button>
        <div class="right"><Picture {...portraitProps} /></div>
      </div>
      <section class="directory">
        <h2>Directory</h2>
        <ul>
          <li><a href="/writing"><img class="link-logo" src="/images/slash.png" alt="" />writing</a></li>
          <li><a href="/projects"><img class="link-logo" src="/images/slash.png" alt="" />projects</a></li>
          <li><a href="/guestbook"><img class="link-logo" src="/images/slash.png" alt="" />guestbook</a></li>
        </ul>
      </section>
    </div>
    <footer class="footer">
      <a href="https://www.linkedin.com/in/keoganlarade/" target="_blank" rel="noopener">
        <Image class="footer-logo" src={linkedin} width={72} sizes="32px" alt="LinkedIn" />
      </a>
      <a href="mailto:keog@nlara.de">
        <Image class="footer-logo" src={mail} width={72} sizes="32px" alt="Email" />
      </a>
      <span class="site-year footer-year" aria-hidden="true">{YEAR}</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .home-desktop { display: none; }

  /* ---- 2026 ----------------------------------------------------------------
     An edition mark in the faint grey. Desktop: centred at the foot of the
     viewport, out of the grid's flow so the split above does not move.
     Mobile: its own line under the social icons, at the very end of the page. */
  .site-year {
    font-family: Charter, 'Charter BT', 'Iowan Old Style', Georgia, serif;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
    margin: 0;
  }
  .footer-year {
    flex-basis: 100%;
    text-align: center;
  }
  .home-mobile > .footer {
    flex-wrap: wrap;
    row-gap: 0.75rem;
  }

  /* ---- Canoe → drawing -----------------------------------------------------
     The canoe photo is a button: hover (fine pointers), keyboard focus or a tap
     crossfades it into a graphite drawing. The drawing is lazy, so it costs
     nothing until the photo is near the viewport, which on this page is
     immediately; it is ~40 KB. */
  .flip {
    /* Button reset, without touching the flex/radius/overflow that .images
       gives its children. */
    appearance: none;
    background: none;
    border: 0;
    margin: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    display: block;
    position: relative;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .flip :global(picture) { display: contents; }
  .flip :global(.flip-drawing) {
    position: absolute;
    inset: 0;
    opacity: 0;
    filter: grayscale(1);
    object-position: 50% 58%;
    transition: opacity 1s ease;
  }
  .flip[aria-pressed='true'] :global(.flip-drawing),
  .flip:focus-visible :global(.flip-drawing) {
    opacity: 1;
    transition: opacity 0.45s ease;
  }
  /* :focus-visible's outline would be clipped by .images' overflow, so the
     ring is drawn inside the frame instead. */
  .flip:focus-visible { outline: none; }
  .flip:focus-visible::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--ink);
    pointer-events: none;
  }

  /* ---- Mobile / tablet: fit items 1–5 to the viewport ----------------------
     The fold (name → blurb → images → directory) is one flex column as tall as
     the small viewport, minus a small inset so the directory's last line sits
     just above the bottom edge rather than flush against it.

     The gaps used to be fixed margins of 7 / 4.5 / 5 / 5 rem (body padding-top,
     then name, blurb, images). Here they become flex-grow factors in those same
     ratios, so whatever space is left over after the text and images are laid
     out gets shared between them in the original proportions — on any phone
     height, and whether the blurb wraps to three lines or five.

     Growth is applied to the elements themselves rather than to spacer divs:
     .name and .blurb are block boxes whose text stays top-aligned, so their
     extra height reads as the gap below them. .images must NOT grow (its
     children are height: 100%, so a taller box would stretch the photos), so
     the gap above the directory comes from growing .directory instead and
     bottom-aligning its contents. */
  @media (max-width: 1099px) {
    .home-fold {
      display: flex;
      flex-direction: column;
      min-height: calc(100vh - 2.5rem);
      min-height: calc(100svh - clamp(1.75rem, 4svh, 3rem));
    }

    /* The old 7rem body padding-top, now elastic. min-height keeps a floor if
       the content ever outgrows the viewport (large text sizes). */
    .home-fold::before {
      content: '';
      flex: 7 0 0;
      min-height: 2rem;
    }

    .home-fold > .name { flex: 4.5 0 auto; margin: 0; }
    .home-fold > .blurb { flex: 5 0 auto; margin: 0; }
    .home-fold > .images { flex: 0 0 auto; margin: 0; }

    .home-fold > .directory {
      flex: 5 0 auto;
      margin: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    /* Below the fold. Kept in proportion with the gaps above it (it was the
       largest of them at 8rem) so the scroll down to the icons feels the same. */
    .home-mobile > .footer { margin-top: clamp(6rem, 21svh, 13rem); }
  }

  /* ---- Desktop: rail | content ---------------------------------------------
     One grid row as tall as the content (name → photos), centred in the
     viewport. The rail stretches to that row, so its directory starts at the
     name and its icons end at the photos' bottom edge, and the divider is the
     rail's right border extended by --split-pad above and below. Pure CSS: this
     used to be measured in JavaScript on every resize. */
  @media (min-width: 1100px) {
    .home-mobile { display: none; }

    .home-desktop {
      --split-pad: calc(22px + max(0px, 100vh - 700px) * 0.1);
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-content: center;
      min-height: 100vh;
      /* 6vh each way, with the row lifted 1.5vh off true centre. */
      padding-block: 4.5vh 7.5vh;
      position: relative;
    }

    .home-year {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 1.75rem;
      text-align: center;
    }

    .home-rail {
      position: relative;
      box-sizing: border-box;
      width: calc(38.667vw - 227.33px);
      padding: 14px clamp(1.5rem, 4vw, 4rem) 0 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    .home-rail::after {
      content: '';
      position: absolute;
      top: calc(-1 * var(--split-pad));
      bottom: calc(-1 * var(--split-pad));
      left: 100%;
      width: 2px;
      background: var(--hairline);
      border-radius: 2px;
      pointer-events: none;
    }

    .home-directory {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 1.4vh, 2rem);
      align-items: flex-start;
    }

    .home-directory li {
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.6;
    }

    .home-directory a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      color: var(--ink-soft);
      text-decoration: none;
    }

    .home-directory .slash {
      font-family: 'Libre Baskerville', Georgia, serif;
      font-style: italic;
      opacity: 0.75;
    }

    .home-directory .label {
      transition: transform 1s ease, color 0.15s ease;
    }

    .home-social {
      margin-top: auto;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .home-social a {
      border-bottom: 1px solid transparent;
      display: inline-flex;
    }

    .home-social img {
      width: 1.8em;
      height: 1.8em;
      object-fit: contain;
      opacity: 0.75;
      filter: var(--icon-filter);
      display: block;
      transition: transform 1s ease;
    }

    .home-main {
      min-width: 0;
      padding-inline: clamp(1.5rem, 4vw, 4rem);
    }

    .home-content {
      max-width: min(820px, 600px + 15vw);
      width: 100%;
    }

    .home-name {
      margin: 0 0 clamp(2.5rem, 9vh, 12rem);
    }

    .home-desktop .blurb {
      margin: 0 0 clamp(3rem, 11vh, 14rem);
    }

    .home-images {
      margin: 0;
    }
  }

  @media (min-width: 1550px) {
    .home-rail { width: 24vw; }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-directory a:hover .label {
      transform: translateX(5px);
      color: var(--ink);
      transition: transform 0.27s ease, color 0.15s ease;
    }
    .home-social a:hover img {
      transform: scale(1.2);
      transition: transform 0.27s ease;
    }
    .flip:hover :global(.flip-drawing) {
      opacity: 1;
      transition: opacity 0.45s ease;
    }
  }
</style>

<script>
  // Tap (or Enter/Space) pins the drawing; hover alone never changes state.
  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(on));
    });
  });
</script>
