---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout description="Keogan Larade — writing, projects, and notes on quantum computing, music, and art.">
  <h1 class="name" transition:name="page-heading">Keogan Larade</h1>
  <p class="blurb">
    I care most about building things and understanding things. Lately, that's taken shape in quantum computing, music, and art.
  </p>
  <div class="images">
    <div class="left"><img src="/images/canoe.jpg" alt="Canoe on still water" /></div>
    <div class="right"><img src="/images/portrait.jpg" alt="Portrait of Keogan Larade" /></div>
  </div>
  <section class="directory">
    <h2>Directory</h2>
    <ul>
      <li><a href="/writing"><img class="link-logo" src="/images/slash.png" alt="" />writing</a></li>
      <li><a href="/projects"><img class="link-logo" src="/images/slash.png" alt="" />projects</a></li>
      <li><a href="/guestbook"><img class="link-logo" src="/images/slash.png" alt="" />guestbook</a></li>
    </ul>
  </section>
  <footer class="footer">
    <a href="https://www.linkedin.com/in/keoganlarade/" target="_blank" rel="noopener">
      <img class="footer-logo" src="/images/linkedin.png" alt="LinkedIn" />
    </a>
    <a href="mailto:keog@nlara.de">
      <img class="footer-logo" src="/images/mail.png" alt="Email" />
    </a>
  </footer>
</BaseLayout>
