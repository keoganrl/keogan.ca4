---
import ChipsLayout from '../../layouts/ChipsLayout.astro';
import SeriesBoard from '../../chips/components/SeriesBoard.svelte';

// The board for a LIVE series. Reached two ways, both landing here:
//   * production — vercel.json rewrites /chips/<NAME>/leaderboard to this page when
//     no prerendered archive matched, so the pretty URL works for a running series;
//   * dev — /chips/series?series=<NAME>, because astro dev ignores vercel.json.
// The component reads the name from whichever of the two it finds.
//
// client:load, NOT client:only, and this is load-bearing rather than a preference.
// Astro collects an island's scoped CSS by walking what it server-rendered; a
// client:only island renders nothing at build time, so it walks nothing and the
// styles of any CHILD component are dropped from the page. SeriesBoard is a thin
// wrapper around Leaderboard, so every rule that makes the board a board lives in
// that child — under client:only the markup shipped and the stylesheet did not, and
// the page rendered as unstyled lists. The rest of the app gets away with
// client:only because those components carry their own styles directly.
//
// Nothing here needs the browser at render time: SeriesBoard reads the URL inside
// onMount, which does not run during SSR, so it server-renders its loading state
// and picks up the series name on hydration.
---

<ChipsLayout title="Leaderboard — Chips">
  <SeriesBoard client:load />
</ChipsLayout>
