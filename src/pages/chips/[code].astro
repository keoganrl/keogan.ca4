---
import ChipsLayout from '../../layouts/ChipsLayout.astro';
import Invite from '../../chips/components/Invite.svelte';
import { WORDS } from '../../chips/lib/utils/joinCode';

// Join codes come from a fixed word pool (src/chips/lib/utils/joinCode.ts), so
// every shareable invite URL (keogan.ca/chips/WOLF) can be prerendered. The
// component resolves the code against live sessions at visit time. Static
// routes are case-sensitive, so we prerender each word cased three ways — WOLF,
// wolf, Wolf — and let visitors reach a game whether they type or share the
// code in any of them.
export function getStaticPaths() {
  const seen = new Set<string>();
  const paths: { params: { code: string } }[] = [];
  for (const word of WORDS) {
    const variants = [word, word.toLowerCase(), word[0] + word.slice(1).toLowerCase()];
    for (const code of variants) {
      if (seen.has(code)) continue;
      seen.add(code);
      paths.push({ params: { code } });
    }
  }
  return paths;
}

const { code } = Astro.params;
---

<ChipsLayout title={`Join ${code} — Chips`}>
  <Invite code={code} client:only="svelte" />
</ChipsLayout>
