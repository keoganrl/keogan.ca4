---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import canoe from '../assets/images/canoe.jpg';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
}

const {
  title = 'Keogan Larade',
  description = "Keogan Larade — writing, projects, and notes on quantum computing, music, and art.",
  ogImage = canoe.src,
  bodyClass,
} = Astro.props;

// Cover pages draw under the phone's status bar (viewport-fit=cover) so the
// photo runs to the very top of the screen instead of under a cream strip.
const edgeToEdge = bodyClass?.split(' ').includes('has-cover') ?? false;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={`width=device-width, initial-scale=1.0${edgeToEdge ? ', viewport-fit=cover' : ''}`} />
    {edgeToEdge && <meta name="theme-color" content="#403d3a" />}
    {/* Browser chrome follows the page. Values track --paper in global.css. */}
    {!edgeToEdge && <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />}
    {!edgeToEdge && <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="keogan.ca" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <link rel="alternate" type="application/rss+xml" title="Keogan Larade — Writing" href="/rss.xml" />
    <link rel="preload" href="/fonts/charter/charter_regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/libre-baskerville/libre-baskerville-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="manifest" href="/images/site.webmanifest">
    <Analytics />
    <SpeedInsights />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

<style>
  /* Home page's desktop split needs to break out of the default
     reading-column padding/max-width. */
  @media (min-width: 1100px) {
    body.is-home {
      max-width: none;
      padding: 0;
    }
  }

  /* On mobile the home page's top gap is elastic — it's the .home-fold::before
     spacer in index.astro, which shares the leftover viewport height with the
     other gaps. The fixed body padding-top would sit on top of that and break
     the proportions, so drop it here. Side/bottom padding is unchanged. */
  @media (max-width: 1099px) {
    body.is-home { padding-top: 0; }
  }
</style>
