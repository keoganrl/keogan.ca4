# Copy this file to .env.local and fill in the three values.
#   cp .env.local.example .env.local
#
# .env.local is gitignored — it never leaves your machine.

# console.anthropic.com → API keys. Shown once when you create it.
ANTHROPIC_API_KEY=

# Supabase dashboard → Project Settings → Data API.
# These two are the same values already in your Vercel environment; the anon key
# is the public one that ships in the site's JS bundle, so it is safe here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
