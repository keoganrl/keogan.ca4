{
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/profile.js": {
      "maxDuration": 60
    },
    "api/recap.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/chips/:series/leaderboard",
      "destination": "/chips/series"
    }
  ]
}
